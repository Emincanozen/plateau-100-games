{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "PLATEAU_PUB_TEST": "1"
      }
    },
    "apercu": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "_lisezMoi": "Force les blocs d'annonces de TEST via app.config.js. Sans cela, un paquet release sans identifiants reels n'afficherait aucune annonce, et l'APK d'essai ne servirait a rien pour verifier la publicite sur un telephone.",
        "PLATEAU_PUB_TEST": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {}
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./cles/google-play.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "language": "fr-FR"
      }
    }
  }
}
